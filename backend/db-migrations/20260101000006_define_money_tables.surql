-- Per-user finance data. `content` holds JSON-shaped document matching shared DTOs (transaction, contract, goal).

DEFINE TABLE OVERWRITE transactions TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE owner ON transactions TYPE record<user> ASSERT $value != NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE content ON transactions TYPE object FLEXIBLE PERMISSIONS FULL;

DEFINE TABLE OVERWRITE contracts TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE owner ON contracts TYPE record<user> ASSERT $value != NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE content ON contracts TYPE object FLEXIBLE PERMISSIONS FULL;

DEFINE TABLE OVERWRITE goals TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE owner ON goals TYPE record<user> ASSERT $value != NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE content ON goals TYPE object FLEXIBLE PERMISSIONS FULL;

DEFINE TABLE OVERWRITE attachments TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD OVERWRITE owner ON attachments TYPE record<user> ASSERT $value != NONE PERMISSIONS FULL;
DEFINE FIELD OVERWRITE content ON attachments TYPE object FLEXIBLE PERMISSIONS FULL;
